{
  "name": "openalex-cv-parser",
  "account_id": "a452eddbbe06eb7d02f4879cee70d29c",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "placement": {
    "mode": "smart"
  },
  // oxjob #1685: every log line goes to Better Stack (source cf-cv-parser) via the account's OTLP destination
  // betterstack-cv-parser; persist: false keeps it out of Workers Logs storage (nothing reads it there).
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": false, "destinations": ["betterstack-cv-parser"] }
  },
  // Use api.openalex.org by default. If sub-requests loop through the
  // proxy and get blocked, set this to the direct upstream URL in the
  // Cloudflare dashboard (Settings > Variables > Environment Variables).
  "vars": {
    "OPENALEX_API_BASE": "https://api.openalex.org"
  }
}
