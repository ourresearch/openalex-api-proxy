# Copy to runbooks/api-slowdown/.env (gitignored). All four are needed.
ES_URL_WALDEN=https://user:pass@<prod-walden-cluster>:9243      # production ES (works-v34 etc.), read-only is enough
ES_URL_MONITORING=https://user:pass@<monitoring-cluster>:9243   # Elastic Cloud monitoring deployment: slow logs + metricbeat
R2_ACCOUNT_ID=                                                 # Cloudflare account id (Our Research) for the Analytics Engine SQL API
ANALYTICS_READ_ONLY_API_KEY=                                   # Cloudflare API token with Account Analytics:Read (same as .dev.vars)
