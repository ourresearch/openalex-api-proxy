{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "openalex-api-proxy",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-03",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"preview_urls": true,
	"keep_vars": true,  // warning: this allows us to put plain text settings in the UI. If false it will delete them.
	"vars": {
		// Feature flag for /query/text (plain words to OQL, oxjob #1494): user or org ids allowed to call it, comma-separated.
		// Jason's account only while it's in testing (2026-10-11); empty = nobody.
		"QUERY_TEXT_ACCOUNTS": "user-TSamuHxDbnhn",
		// Per-second cap override (oxjob #1689): user or org ids, comma-separated, whose keys get their own per-second cap
		// instead of the 50/30/10 tiers: `id` = 500/s, `id:rps` = that (at most 1000). For openalex.org's server-rendering
		// key. Daily credits are unchanged; malformed entries are skipped. Set it here, not in the dashboard: a deploy
		// overwrites a dashboard value with this one. Empty = nobody. See src/highRps.ts.
		"HIGH_RPS_ACCOUNTS": "user-cqqCosHNn95S,user-PD7oDjspQaE8"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 0.10,
		// oxjob #1685: every sampled log line also goes to Better Stack (source cf-api-proxy) through the account's
		// OTLP destination betterstack-api-proxy. persist stays true (Workers Logs) until ox-logs reads Better Stack;
		// raising the sampling rate raises Workers Logs and export together, so change both bills' estimates first.
		"logs": { "enabled": true, "head_sampling_rate": 0.10, "invocation_logs": true, "destinations": ["betterstack-api-proxy"] }
	},
	// Sentry release = this deploy's version id (oxjob #1685; SENTRY_DSN is a Worker secret).
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	"analytics_engine_datasets": [
		{
			"binding": "ANALYTICS",
			"dataset": "openalex_requests_v2"
		}
	],
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "0631da2956b94f12812215860e67cc2b"
		}
	],
	"routes": [
		{ "pattern": "api.openalex.org/*", "zone_name": "openalex.org" },
		{ "pattern": "content.openalex.org/*", "zone_name": "openalex.org" }
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "RATE_LIMITER",
				"class_name": "RateLimiter"
			},
			{
				// oxjob #521 WS-3 Phase 0: global search-health monitor (observe-only)
				"name": "SEARCH_HEALTH",
				"class_name": "SearchHealthController"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_classes": [
				"RateLimiter"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"SearchHealthController"
			]
		}
	],
	"services": [
		{
			"binding": "CONTENT_WORKER",
			"service": "openalex-content-worker"
		},
		{
			"binding": "CV_PARSER",
			"service": "openalex-cv-parser"
		},
		{
			// /query/text: plain words to OQL (oxjob #1494). The Worker has no public route; it is reachable only here,
			// so every call is held and settled by this proxy. Built from openalex-mcp-server (wrangler.query-writer.jsonc).
			"binding": "QUERY_WRITER",
			"service": "openalex-query-writer"
		}
	]
}
